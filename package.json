{
  "name": "ap-three-way-matching-agent",
  "version": "1.0.0",
  "description": "SAP CAP application for invoice three-way matching, discrepancy review, and approval-gated resolution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lassoregression/AP-Three-Way-Matching-Agent"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds serve",
    "dev": "cds watch",
    "build": "cds build && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint srv",
    "deploy:hana": "cds deploy --to hana"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.16.0",
    "@jest/globals": "^30.3.0",
    "@sap/cds-dk": "^9.8.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "globals": "^17.7.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4",
    "typescript": "^5"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/gen/"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.+)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@cap-js/audit-logging": "^1.2.0",
    "@cap-js/sqlite": "^2.2.0",
    "@sap-ai-sdk/foundation-models": "^2.9.0",
    "@sap-ai-sdk/orchestration": "^2.9.0",
    "@sap/cds": "^9.8.3",
    "decimal.js": "^10.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  }
}
